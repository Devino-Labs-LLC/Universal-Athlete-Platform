DB_HOST=db-host
DB_PORT=db-port
DB_NAME=db-schema-name
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=db-username
SPRING_DATASOURCE_PASSWORD=db-password

UAP_IDENTITY_ACCESS_TOKEN_SECRET=your-super-long-secret-32-character-long-token

# Production: activate the prod profile so localhost CORS and insecure cookies
# cannot ship. Allowlist the exact browser origin (no wildcard).
# SPRING_PROFILES_ACTIVE=prod
# UAP_COOKIE_SECURE=true
# UAP_CORS_ALLOWED_ORIGINS=https://app.example.com

# V4 Slice C — product-edge entitlement enforcement (independent of Stripe). Default false.
# UAP_BILLING_ENTITLEMENT_ENFORCEMENT_ENABLED=false

# V4 Slice B — Stripe sandbox (never commit real keys). Prefer a restricted test key.
# UAP_BILLING_STRIPE_ENABLED=true
# UAP_BILLING_STRIPE_SECRET_KEY=rk_test_or_sk_test_replace_me
# UAP_BILLING_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# UAP_BILLING_STRIPE_SUCCESS_URL=http://localhost:3000/coach/billing/success?session_id={CHECKOUT_SESSION_ID}
# UAP_BILLING_STRIPE_CANCEL_URL=http://localhost:3000/coach/billing/cancel
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_25_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_25_ANNUAL=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_75_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_75_ANNUAL=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_250_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_250_ANNUAL=price_replace_me
