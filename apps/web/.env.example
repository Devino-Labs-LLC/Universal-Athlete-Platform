# development | staging | production
# Release builds (vite build / PROD) reject missing env and reject `development`.
VITE_UAP_ENV=development

# Optional in development (defaults to same-origin via Vite /api proxy → localhost:8080).
# Required for staging and production — absolute HTTPS URL; localhost and embedded credentials forbidden.
# Authoritative name: VITE_UAP_API_BASE_URL (VITE_UAP_API_URL is ignored).
# VITE_UAP_API_BASE_URL=https://api.example.com
