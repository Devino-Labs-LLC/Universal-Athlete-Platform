# =========================
# Node / pnpm
# =========================
node_modules/
.pnpm-store/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Do not allow npm or Yarn lockfiles
# because pnpm is authoritative.
package-lock.json
yarn.lock

# Keep pnpm lockfiles committed.
!pnpm-lock.yaml

# =========================
# Next.js / frontend
# =========================
.next/
out/
coverage/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/

# =========================
# Java / Gradle / Spring
# =========================
.gradle/
build/
bin/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Keep Gradle wrapper JAR committed.
!backend/uap-server/gradle/wrapper/gradle-wrapper.jar

# =========================
# Terraform
# =========================
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform dependency lock should be committed.
!.terraform.lock.hcl

