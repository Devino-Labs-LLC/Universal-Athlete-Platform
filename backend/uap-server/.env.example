DB_HOST=db-host
DB_PORT=db-port
DB_NAME=db-schema-name
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=db-username
SPRING_DATASOURCE_PASSWORD=db-password

UAP_IDENTITY_ACCESS_TOKEN_SECRET=your-super-long-secret-32-character-long-token

# Production: activate the prod profile so localhost CORS and insecure cookies
# cannot ship. Allowlist the exact browser origin (no wildcard).
# SPRING_PROFILES_ACTIVE=prod
# UAP_COOKIE_SECURE=true
# UAP_CORS_ALLOWED_ORIGINS=https://app.example.com

# V5 F1 — Connected Athlete integrations (module always present; providers fail-closed).
# UAP_INTEGRATIONS_ENABLED=true
# UAP_INTEGRATIONS_BACKFILL_DAYS=30
# UAP_INTEGRATIONS_APPLE_HEALTHKIT_ENABLED=false
# UAP_INTEGRATIONS_HEALTH_CONNECT_ENABLED=false

# V4 Slice C — product-edge entitlement enforcement (independent of Stripe). Default false.
# UAP_BILLING_ENTITLEMENT_ENFORCEMENT_ENABLED=false

# V4 Slice D — Organization active-athlete capacity (independent of Stripe and entitlement). Default false.
# UAP_BILLING_ORGANIZATION_CAPACITY_ENFORCEMENT_ENABLED=false

# V4 G2 — Apple App Store Server API (Sandbox). Default off. Do not invent credentials.
# Sandbox certification is blocked until real App Store Connect API credentials exist.
# UAP_BILLING_APPLE_ENABLED=true
# UAP_BILLING_APPLE_BUNDLE_ID=com.example.athletereadiness
# UAP_BILLING_APPLE_KEY_ID=replace_me
# UAP_BILLING_APPLE_ISSUER_ID=00000000-0000-0000-0000-000000000000
# UAP_BILLING_APPLE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
# UAP_BILLING_APPLE_ENVIRONMENT=Sandbox
# UAP_BILLING_APPLE_PRODUCT_INDIVIDUAL_PREMIUM_MONTHLY=premium.monthly
# UAP_BILLING_APPLE_PRODUCT_INDIVIDUAL_PREMIUM_ANNUAL=premium.annual

# V4 G3 — Google Play Developer API / RTDN (Sandbox / license-test). Default off. Do not invent credentials.
# Sandbox certification is blocked until real Play Console service-account credentials exist.
# UAP_BILLING_GOOGLE_PLAY_ENABLED=true
# UAP_BILLING_GOOGLE_PLAY_PACKAGE_NAME=com.example.athletereadiness
# UAP_BILLING_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace","private_key_id":"replace","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n","client_email":"play-billing@replace.iam.gserviceaccount.com","client_id":"replace","token_uri":"https://oauth2.googleapis.com/token"}
# UAP_BILLING_GOOGLE_PLAY_ENVIRONMENT=Sandbox
# UAP_BILLING_GOOGLE_PLAY_PRODUCT_INDIVIDUAL_PREMIUM_MONTHLY=premium.monthly
# UAP_BILLING_GOOGLE_PLAY_PRODUCT_INDIVIDUAL_PREMIUM_ANNUAL=premium.annual

# V4 Slice B — Stripe sandbox (never commit real keys). Prefer a restricted test key.
# UAP_BILLING_STRIPE_ENABLED=true
# UAP_BILLING_STRIPE_SECRET_KEY=rk_test_or_sk_test_replace_me
# UAP_BILLING_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# UAP_BILLING_STRIPE_SUCCESS_URL=http://localhost:3000/coach/billing/success?session_id={CHECKOUT_SESSION_ID}
# UAP_BILLING_STRIPE_CANCEL_URL=http://localhost:3000/coach/billing/cancel
# UAP_BILLING_STRIPE_INDIVIDUAL_SUCCESS_URL=http://localhost:3000/app/billing/success?session_id={CHECKOUT_SESSION_ID}
# UAP_BILLING_STRIPE_INDIVIDUAL_CANCEL_URL=http://localhost:3000/app/billing/cancel
# UAP_BILLING_STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
# UAP_BILLING_STRIPE_PORTAL_RETURN_URL=http://localhost:3000/coach/organizations/replace-me/billing
# UAP_BILLING_STRIPE_INDIVIDUAL_PORTAL_RETURN_URL=http://localhost:3000/app/billing
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_25_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_25_ANNUAL=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_75_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_75_ANNUAL=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_250_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_ORG_BAND_250_ANNUAL=price_replace_me
# UAP_BILLING_STRIPE_PRICE_INDIVIDUAL_PREMIUM_MONTHLY=price_replace_me
# UAP_BILLING_STRIPE_PRICE_INDIVIDUAL_PREMIUM_ANNUAL=price_replace_me
