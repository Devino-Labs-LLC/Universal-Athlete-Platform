DB_HOST=db-host
DB_PORT=db-port
DB_NAME=db-schema-name
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=db-username
SPRING_DATASOURCE_PASSWORD=db-password

UAP_IDENTITY_ACCESS_TOKEN_SECRET=your-super-long-secret-32-character-long-token

# Production (Railway UAP_Server): activate the prod profile so localhost CORS
# and insecure cookies cannot ship. Allowlist the exact browser origin.
# SPRING_PROFILES_ACTIVE=prod
# UAP_COOKIE_SECURE=true
# UAP_CORS_ALLOWED_ORIGINS=https://uapclientweb-production.up.railway.app